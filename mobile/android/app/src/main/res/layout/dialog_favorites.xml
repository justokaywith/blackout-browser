<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blackout_bg"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#2b2d42" />

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites"
            android:textColor="@color/blackout_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Add Current Page button -->
        <TextView
            android:id="@+id/btn_add_current_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Current Page"
            android:textColor="@color/blackout_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Close button -->
        <ImageView
            android:id="@+id/btn_close_favorites_sheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blackout_line" />

    <!-- Empty state message -->
    <TextView
        android:id="@+id/tv_empty_favorites"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:gravity="center"
        android:text="No favorites saved yet"
        android:textColor="@color/blackout_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Favorites list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="460dp"
        android:paddingVertical="4dp"
        android:clipToPadding="false" />
</LinearLayout>
