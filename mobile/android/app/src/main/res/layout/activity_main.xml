<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blackout_bg">

    <!-- Normal App Layout (Web Views + Progress Bar + Persistent Chin) -->
    <LinearLayout
        android:id="@+id/main_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/web_progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="@color/blackout_purple"
            android:visibility="gone" />

        <!-- Dynamic Web View Container for Active Tab -->
        <FrameLayout
            android:id="@+id/web_view_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/blackout_bg" />

        <!-- Persistent Blackout Chin (Bottom Bar) -->
        <LinearLayout
            android:id="@+id/persistent_chin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/blackout_chin_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Omnibar: Lock Icon + URL/Search Input + Clear/Go -->
            <LinearLayout
                android:id="@+id/chin_omnibar"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chin_omnibar"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/chin_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="12sp"
                    android:textColor="@color/blackout_teal" />

                <EditText
                    android:id="@+id/chin_url_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search or type URL"
                    android:textColorHint="#6a6880"
                    android:textColor="@color/blackout_text"
                    android:textSize="13.5sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:selectAllOnFocus="true"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/chin_btn_clear"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    android:contentDescription="Clear URL" />
            </LinearLayout>

            <!-- Navigation Buttons Cluster -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btn_chin_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="11dp"
                    android:src="@drawable/ic_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />

                <!-- Forward Button -->
                <ImageView
                    android:id="@+id/btn_chin_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="11dp"
                    android:src="@drawable/ic_forward"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Forward" />

                <!-- Home Button -->
                <ImageView
                    android:id="@+id/btn_chin_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="11dp"
                    android:src="@drawable/ic_home"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home" />

                <!-- Tabs Button (with badge count box) -->
                <FrameLayout
                    android:id="@+id/btn_chin_tabs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tabs">

                    <TextView
                        android:id="@+id/tv_chin_tab_count"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/bg_tab_box"
                        android:text="1"
                        android:textColor="#A8A6BE"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Menu Button -->
                <ImageView
                    android:id="@+id/btn_chin_menu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="11dp"
                    android:src="@drawable/ic_menu"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen Video Custom View Container (For YouTube & HTML5 Video) -->
    <FrameLayout
        android:id="@+id/fullscreen_custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
