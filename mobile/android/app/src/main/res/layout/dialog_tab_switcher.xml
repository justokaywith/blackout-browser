<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blackout_bg"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Bottom sheet handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#2b2d42" />

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp">

        <!-- Mode switcher pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#121320"
            android:padding="3dp">

            <TextView
                android:id="@+id/btn_mode_standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tabs (1)"
                android:textColor="@color/blackout_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_active" />

            <TextView
                android:id="@+id/btn_mode_private"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🕶️ Private (0)"
                android:textColor="@color/blackout_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_inactive" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- + New Tab button -->
        <TextView
            android:id="@+id/btn_sheet_new_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ New Tab"
            android:textColor="@color/blackout_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Close sheet button -->
        <ImageView
            android:id="@+id/btn_sheet_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blackout_line" />

    <!-- Tabs List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tab_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

    <!-- Footer actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/btn_close_all_tabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Close All Tabs"
            android:textColor="@color/blackout_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
