<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_engine_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tab_card"
    android:clickable="true"
    android:focusable="true">

    <!-- Emoji / Icon -->
    <TextView
        android:id="@+id/tv_engine_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textSize="18sp"
        android:text="🦆" />

    <!-- Name and URL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tv_engine_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blackout_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="DuckDuckGo" />

        <TextView
            android:id="@+id/tv_engine_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blackout_muted"
            android:textSize="11.5sp"
            android:text="https://duckduckgo.com" />
    </LinearLayout>

    <!-- Active Indicator Checkmark -->
    <TextView
        android:id="@+id/tv_engine_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ Active"
        android:textColor="@color/blackout_teal"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
