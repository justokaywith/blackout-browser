<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/blackout_bg"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#2E2B45"
        android:layout_marginBottom="16dp" />

    <!-- Header: Title and Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blackout Sovereign Support"
            android:textColor="@color/blackout_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/btn_close_support_sheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reach out directly to the Pactuno development team for help, bug reports, or feature requests."
        android:textColor="@color/blackout_muted"
        android:textSize="12.5sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="18dp" />

    <!-- Option 1: Live Web Support Portal -->
    <LinearLayout
        android:id="@+id/support_opt_portal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_tab_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="🌐" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online Support Portal"
                android:textColor="@color/blackout_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pactuno.online/support.html"
                android:textColor="@color/blackout_teal"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="@color/blackout_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Option 2: Email Developer Support -->
    <LinearLayout
        android:id="@+id/support_opt_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_tab_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="✉️" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Engineering Team"
                android:textColor="@color/blackout_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="support@pactuno.online"
                android:textColor="@color/blackout_purple"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="@color/blackout_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Option 3: Sovereign Browser Docs -->
    <LinearLayout
        android:id="@+id/support_opt_docs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_tab_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="📖" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documentation &amp; Sovereign Architecture"
                android:textColor="@color/blackout_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pactuno.online/blackout.html"
                android:textColor="@color/blackout_muted"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="@color/blackout_muted"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
